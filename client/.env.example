# URL of the backend signaling & API server
# Default for local development: http://localhost:3001
# In Vercel / Production settings, set this to your live cloud backend HTTPS URL:
# VITE_SERVER_URL=https://musica-signaling-server.onrender.com
VITE_SERVER_URL=http://localhost:3001

# LiveKit SFU WebSocket Endpoint
VITE_LIVEKIT_URL=wss://musica-t6p6knyc.livekit.cloud

