# ==============================================================================
# MUSICA SERVER ENVIRONMENT VARIABLES (.env)
# ==============================================================================

# HTTP and Socket.IO listening port
# Default: 3001
PORT=3001

# Allowed Frontend Client Origin for CORS security & signaling handshakes
# Default for local development: http://localhost:5173
# In Production, set this to your deployed Vercel domain:
# CLIENT_URL=https://musica-apvs.vercel.app
CLIENT_URL=http://localhost:5173

# Application logging verbosity (debug | info | warn | error)
LOG_LEVEL=info
